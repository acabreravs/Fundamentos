
#include <iostream>
#include <string>
#define MAX 100

using namespace std;

struct Usuario {
	string usuario;
	string clave;
};

struct Persona {
	string nombre;
	string fecha;
	string ci;
	string direccion;
	string telefono;
};

Usuario usuarios[MAX];
int cant_usuarios = 0;

Persona personas[MAX];
int cant_personas = 0;

// Prototipos de funciones
bool validar_fecha(string fecha);
void registrar_usuario();
void listar_usuarios();
void modificar_usuario();
void borrar_usuario();
bool login();

void registrar_persona();
void listar_personas();
void borrar_persona();
void modificar_persona();
void menu_personas();


void PantallaRegistroUsuario() {
    DibujarMarcoContenido("REGISTRO DE USUARIO");
    DibujarTextoCentrado("Completa tus datos para crear una cuenta", 120, 22, VERDE);
    DibujarCampo(250, 185, 600, "Nombre completo", campos[0], campoActivo == 0);
    DibujarCampo(250, 270, 600, "Contrasena", campos[1], campoActivo == 1);
    DibujarTextoCentrado("Tipo de cuenta:", 355, 19, GRIS);
    if (IsMouseButtonPressed(MOUSE_BUTTON_LEFT)) {
        Vector2 m = GetMousePosition();
        if (CheckCollisionPointRec(m, { 250, 185, 600, 48 })) campoActivo = 0;
        if (CheckCollisionPointRec(m, { 250, 270, 600, 48 })) campoActivo = 1;
    }
    ProcesarEntradaCampo(60, false);
    if (formularioError)
        DrawText(textoError.c_str(), 250, 420, 17, ROJO);
    if (Boton(250, 465, 250, 55, "CREAR CUENTA CLIENTE")) {
        if (campos[0].empty() || campos[1].empty()) {
            formularioError = true; textoError = "Completa el nombre y la contrasena.";
        }
        else if (nUsuarios >= MAX) {
            formularioError = true; textoError = "Se alcanzo el limite de usuarios.";
        }
        else {
            Usuario u = { nUsuarios + 1, campos[0], "Cliente", true };
            usuarios[nUsuarios] = u;
            contrasenas[nUsuarios] = campos[1];
            clienteActual = u.id;
            nUsuarios++;
            IrAPantalla(CLIENTE_MENU);
            mensaje = "Cuenta creada. Tu ID de usuario es: " + to_string(u.id);
        }
    }
    if (Boton(600, 465, 250, 55, "CREAR CUENTA COMERCIO")) {
        if (campos[0].empty() || campos[1].empty()) {
            formularioError = true; textoError = "Completa el nombre y la contrasena.";
        }
        else if (nUsuarios >= MAX || nComercios >= MAX) {
            formularioError = true; textoError = "Se alcanzo el limite de registros.";
        }
        else {
            Usuario u = { nUsuarios + 1, campos[0], "Comercio", true };
            usuarios[nUsuarios] = u;
            contrasenas[nUsuarios] = campos[1];
            nUsuarios++;
            LimpiarFormulario(3);
            IrAPantalla(ADMIN_REGISTRAR_COMERCIO);
            mensaje = "Completa los datos de tu comercio.";
            comercioActual = u.id; // Durante el registro guarda temporalmente el id del usuario
        }
    }
    if (Boton(400, 610, 300, 45, "VOLVER"))
        IrAPantalla(PRINCIPAL);
}
void PantallaInicioSesion() {
    DibujarMarcoContenido("INICIAR SESION");
    DibujarTextoCentrado("Ingresa tu ID y contrasena", 145, 24, VERDE);
    DibujarCampo(350, 235, 400, "ID de usuario", campos[0], campoActivo == 0);
    DibujarCampo(350, 335, 400, "Contrasena", campos[1], campoActivo == 1);
    if (IsMouseButtonPressed(MOUSE_BUTTON_LEFT)) {
        Vector2 m = GetMousePosition();
        if (CheckCollisionPointRec(m, { 350, 235, 400, 48 })) campoActivo = 0;
        if (CheckCollisionPointRec(m, { 350, 335, 400, 48 })) campoActivo = 1;
    }
    ProcesarEntradaCampo(60, false);
    if (formularioError)
        DrawText(textoError.c_str(), 300, 420, 17, ROJO);
    if (Boton(350, 475, 190, 55, "INGRESAR")) {
        int id = 0;
        if (!ConvertirEntero(campos[0], id) || !iniciarSesionDatos(id, campos[1])) {
            formularioError = true;
            textoError = "ID o contrasena incorrectos, o cuenta inactiva.";
        }
        else {
            int pos = buscarUsuarioPorID(id);
            if (usuarios[pos].tipo == "Administrador") IrAPantalla(ADMINISTRADOR);
            else if (usuarios[pos].tipo == "Cliente") {
                clienteActual = id; IrAPantalla(CLIENTE_MENU);
            }
            else if (usuarios[pos].tipo == "Comercio") {
                int pc = -1;
                for (int i = 0; i < nComercios; i++)
                    if (comercios[i].idUsuario == id && comercios[i].activo) pc = i;
                if (pc == -1) {
                    formularioError = true; textoError = "La cuenta no tiene un comercio registrado.";
                }
                else {
                    comercioActual = comercios[pc].id;
                    IrAPantalla(COMERCIO_MENU);
                }
            }
        }
    }
    if (Boton(600, 475, 190, 55, "VOLVER"))
        IrAPantalla(PRINCIPAL);
}

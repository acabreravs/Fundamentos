                comercios[nComercios++] = c;
                comercioActual = c.id;
                IrAPantalla(COMERCIO_MENU);
                mensaje = "Cuenta y comercio registrados correctamente.";
            }
            else {
                registrarComercioDatos(campos[0], campos[1], campos[2], campos[3]);

//Funciones de datos y reglas del negiocio
int buscarUsuarioPorID(int id) {
    for (int i = 0; i < nUsuarios; i++)
        if (usuarios[i].id == id) return i;
    return -1;
}
void inicializarAdministrador() {
    if (nUsuarios >= MAX) return;
    usuarios[nUsuarios] = { 1, "Administrador", "Administrador", true };
    contrasenas[nUsuarios] = "admin123";
    nUsuarios++;
}
bool iniciarSesionDatos(int id, const string& contrasena) {
    int pos = buscarUsuarioPorID(id);
    return pos != -1 && usuarios[pos].activo && contrasenas[pos] == contrasena;
}
int buscarProductoPorID(int id) {
    for (int i = 0; i < nProductos; i++)
        if (productos[i].id == id && productos[i].activo) return i;
    return -1;
}
int buscarComercioPorID(int id) {
    for (int i = 0; i < nComercios; i++)
        if (comercios[i].id == id && comercios[i].activo) return i;
    return -1;
}
void registrarComercioDatos(const string& nombre, const string& direccion, const string& telefono, const string& contrasena) {
    if (nComercios >= MAX || nUsuarios >= MAX) return;
    Comercio c;
    c.id = siguienteComercio++;
    c.idUsuario = nUsuarios + 1;
    c.nombre = nombre;
    c.direccion = direccion;
    c.telefono = telefono;
    c.activo = true;
    comercios[nComercios++] = c;
    usuarios[nUsuarios] = { c.idUsuario, c.nombre, "Comercio", true };
    contrasenas[nUsuarios] = contrasena;
    nUsuarios++;
}
void registrarClienteDatos(const string& nombre, const string& contrasena) {
    if (nUsuarios >= MAX) return;
    Usuario u;
    u.id = nUsuarios + 1;
    u.nombre = nombre;
    u.tipo = "Cliente";
    u.activo = true;
    usuarios[nUsuarios] = u;
    contrasenas[nUsuarios] = contrasena;
    nUsuarios++;
}
bool publicarProductoDatos(int idComercio, const string& nombre,
    double original, double oferta, int stock) {
    if (nProductos >= MAX) return false;
    if (buscarComercioPorID(idComercio) == -1) return false;
    if (nombre.empty() || original <= 0 || oferta <= 0 ||
        oferta >= original || stock <= 0) return false;
    Producto p;
    p.id = siguienteProducto++;
    p.idComercio = idComercio;
    p.nombre = nombre;
    p.precioOriginal = original;
    p.precioOferta = oferta;
    p.stock = stock;
    p.activo = true;
    productos[nProductos++] = p;
    return true;
}
bool actualizarStockDatos(int idComercio, int idProducto, int cantidad) {
    int pos = buscarProductoPorID(idProducto);
    if (pos == -1 || productos[pos].idComercio != idComercio || cantidad < 0)
        return false;
    productos[pos].stock = cantidad;
    return true;
}
bool realizarReservaDatos(int idCliente, int idProducto, int cantidad) {
    if (nReservas >= MAX) return false;
    bool clienteValido = false;
    for (int i = 0; i < nUsuarios; i++)
        if (usuarios[i].id == idCliente && usuarios[i].tipo == "Cliente" && usuarios[i].activo)
            clienteValido = true;
    if (!clienteValido) return false;
    int pos = buscarProductoPorID(idProducto);
    if (pos == -1) return false;
    if (cantidad <= 0 || cantidad > productos[pos].stock) return false;
    Reserva r;
    r.id = siguienteReserva++;
    r.idCliente = idCliente;
    r.idProducto = idProducto;
    r.cantidad = cantidad;
    r.total = productos[pos].precioOferta * cantidad;
    r.estado = "Pendiente";
    reservas[nReservas++] = r;
    productos[pos].stock -= cantidad;
    return true;
}
bool cancelarReservaDatos(int idCliente, int idReserva) {
    for (int i = 0; i < nReservas; i++) {
        if (reservas[i].id == idReserva && reservas[i].idCliente == idCliente) {
            if (reservas[i].estado != "Pendiente") return false;
            int pos = buscarProductoPorID(reservas[i].idProducto);
            if (pos != -1) productos[pos].stock += reservas[i].cantidad;
            reservas[i].estado = "Cancelada";
            return true;
        }
    }
    return false;
}
bool completarReservaDatos(int idComercio, int idReserva) {
    for (int i = 0; i < nReservas; i++) {
        if (reservas[i].id == idReserva) {
            int pos = buscarProductoPorID(reservas[i].idProducto);
            if (pos == -1 || productos[pos].idComercio != idComercio) continue;
            if (reservas[i].estado != "Pendiente") return false;
            reservas[i].estado = "Completada";
            return true;
        }
    }
    return false;
}
double calcularDescuento(double original, double oferta) {
    if (original <= 0 || oferta < 0 || oferta > original) return 0;
    return original - oferta;
}
double calcularPorcentajeDescuento(double original, double oferta) {
    if (original <= 0 || oferta < 0 || oferta > original) return 0;
    return ((original - oferta) / original) * 100;
}
double calcularTotalReserva(double precio, int cantidad) {
    if (precio < 0 || cantidad < 0) return 0;
    return precio * cantidad;
}
double calcularAhorroCliente(int idCliente) {
    double ahorro = 0;
    for (int i = 0; i < nReservas; i++) {
        if (reservas[i].idCliente == idCliente && reservas[i].estado == "Completada") {
            int pos = buscarProductoPorID(reservas[i].idProducto);
            if (pos != -1)
                ahorro += calcularDescuento(productos[pos].precioOriginal,
                    productos[pos].precioOferta) * reservas[i].cantidad;
        }
    }
    return ahorro;
}
double calcularIngresosComercio(int idComercio) {
    double ingresos = 0;
    for (int i = 0; i < nReservas; i++) {
        if (reservas[i].estado == "Completada") {
            int pos = buscarProductoPorID(reservas[i].idProducto);
            if (pos != -1 && productos[pos].idComercio == idComercio)
                ingresos += reservas[i].total;
        }
    }
    return ingresos;
}
double calcularIngresosTotales() {
    double total = 0;
    for (int i = 0; i < nReservas; i++)
        if (reservas[i].estado == "Completada") total += reservas[i].total;
    return total;
}

//entradas de texto para formularios
void DibujarCampo(int x, int y, int ancho, const char* etiqueta,
    const string& valor, bool activo, bool numerico = false) {
    DrawText(etiqueta, x, y - 27, 18, GRIS);
    DrawRectangleRec({ (float)x, (float)y, (float)ancho, 48 }, BLANCO);
    DrawRectangleLinesEx({ (float)x, (float)y, (float)ancho, 48 }, 2,
        activo ? VERDE_CLARO : GRIS);
    string visible = valor;
    if (visible.size() > 48)
        visible = visible.substr(visible.size() - 48);
    DrawText(visible.c_str(), x + 12, y + 14, 18, GRIS);
    if (activo && ((int)(GetTime() * 2) % 2 == 0)) {
        int cursorX = x + 12 + MeasureText(visible.c_str(), 18);
        DrawLine(cursorX, y + 10, cursorX, y + 37, VERDE);
    }
}
void ProcesarEntradaCampo(int maxCaracteres = 70, bool permitirDecimal = false) {
    int tecla = GetCharPressed();
    while (tecla > 0) {
        bool valido = (tecla >= 32 && tecla <= 125);
        if (permitirDecimal)
            valido = valido && ((tecla >= '0' && tecla <= '9') || tecla == '.');
        if (valido && (int)campos[campoActivo].size() < maxCaracteres)
            campos[campoActivo] += (char)tecla;
        tecla = GetCharPressed();
    }
    if (IsKeyPressed(KEY_BACKSPACE) && !campos[campoActivo].empty())
        campos[campoActivo].pop_back();
    if (IsKeyPressed(KEY_TAB) || IsKeyPressed(KEY_ENTER))
        campoActivo = (campoActivo + 1) % cantidadCamposActivos;
}
void DibujarErrorFormulario() {
    if (formularioError && !textoError.empty())
        DrawText(textoError.c_str(), 190, 525, 17, ROJO);
}
bool ConvertirEntero(const string& texto, int& valor) {
    if (texto.empty()) return false;
    try {
        size_t pos = 0;
        int n = stoi(texto, &pos);
        if (pos != texto.size()) return false;
        valor = n;
        return true;
    }
    catch (...) { return false; }
}
bool ConvertirDecimal(const string& texto, double& valor) {
    if (texto.empty()) return false;
    try {
        size_t pos = 0;
        double n = stod(texto, &pos);
        if (pos != texto.size()) return false;
        valor = n;
        return true;
    }
    catch (...) { return false; }
}

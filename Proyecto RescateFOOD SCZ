void LimpiarFormulario(int cantidadCampos) {
    for (int i = 0; i < 4; i++) campos[i].clear();
    cantidadCamposActivos = (cantidadCampos < 1 || cantidadCampos > 4) ? 1 : cantidadCampos;
    campoActivo = 0;
    formularioError = false;
    textoError.clear();
}
void IrAPantalla(Pantalla destino) {
    pantallaActual = destino;
    mensaje.clear();
    formularioError = false;
    textoError.clear();
}
//graficas generales
bool Boton(float x, float y, float ancho, float alto, const char* texto) {
    Rectangle r = { x, y, ancho, alto };
    Vector2 mouse = GetMousePosition();
    bool encima = CheckCollisionPointRec(mouse, r);
    DrawRectangleRec(r, encima ? VERDE_CLARO : VERDE);
    DrawRectangleLinesEx(r, 2, VERDE);
    int tam = MeasureText(texto, 20);
    DrawText(texto, (int)(x + (ancho - tam) / 2), (int)(y + (alto - 20) / 2), 20, BLANCO);
    return encima && IsMouseButtonPressed(MOUSE_BUTTON_LEFT);
}

            formularioError = true; textoError = "Completa todos los campos, incluida la contrasena.";
        }
        else if (nComercios >= MAX || nUsuarios >= MAX) {
            formularioError = true; textoError = "No hay espacio para mas registros.";
        }
        else {
            if (comercioActual > 0) {
                // Registro iniciado desde el flujo antiguo: conserva la contrasena creada por el usuario.
                int idUsuario = comercioActual;
                Comercio c;
                c.id = siguienteComercio++;
                c.idUsuario = idUsuario;
                c.nombre = campos[0];
                c.direccion = campos[1];
                c.telefono = campos[2];

void PantallaFinanzas() {
    DibujarMarcoContenido("REPORTE FINANCIERO");
    int pendientes = 0, completadas = 0, canceladas = 0;
    int unidadesVendidas = 0, productosActivos = 0, unidadesRescatadas = 0;
    double ahorro = 0.0, ingresos = 0.0;
    int mayorCantidad = 0;
    string productoMasVendido = "Todavia no hay ventas";

    for (int i = 0; i < nReservas; i++) {
        if (reservas[i].estado == "Pendiente") pendientes++;
        else if (reservas[i].estado == "Completada") {
            completadas++;
            unidadesVendidas += reservas[i].cantidad;
            ingresos += reservas[i].total;
            int pos = buscarProductoPorID(reservas[i].idProducto);
            if (pos != -1) {
                ahorro += calcularDescuento(productos[pos].precioOriginal,
                    productos[pos].precioOferta) * reservas[i].cantidad;
            }
        }
        else if (reservas[i].estado == "Cancelada") canceladas++;
    }
    for (int i = 0; i < nProductos; i++) {
        if (productos[i].activo) productosActivos++;
        int unidades = 0;
        for (int j = 0; j < nReservas; j++) {
            if (reservas[j].idProducto == productos[i].id &&
                reservas[j].estado == "Completada")
                unidades += reservas[j].cantidad;
        }
        unidadesRescatadas += unidades;
        if (unidades > mayorCantidad) {
            mayorCantidad = unidades;
            productoMasVendido = productos[i].nombre;
        }
    }
    DibujarTextoCentrado("VENTAS Y RESERVAS", 120, 22, VERDE);
    DrawText(TextFormat("Reservas pendientes: %d", pendientes), 90, 165, 19, GRIS);
    DrawText(TextFormat("Reservas completadas: %d", completadas), 390, 165, 19, GRIS);
    DrawText(TextFormat("Reservas canceladas: %d", canceladas), 700, 165, 19, GRIS);
    DrawText(TextFormat("Unidades vendidas: %d", unidadesVendidas), 90, 205, 19, GRIS);
    DrawText(TextFormat("Ingresos totales: Bs %.2f", ingresos), 390, 205, 19, VERDE);
    DrawLine(75, 250, 1025, 250, VERDE);
    DibujarTextoCentrado("DESCUENTOS Y ALIMENTOS RESCATADOS", 275, 22, VERDE);
    DrawText(TextFormat("Ahorro generado para clientes: Bs %.2f", ahorro), 90, 325, 19, GRIS);
    DrawText(TextFormat("Productos activos publicados: %d", productosActivos), 90, 365, 19, GRIS);
    DrawText(TextFormat("Unidades de alimentos rescatadas: %d", unidadesRescatadas), 90, 405, 19, GRIS);
    string etiquetaTop = "Producto con mas unidades vendidas: " + productoMasVendido;
    DrawText(etiquetaTop.c_str(), 90, 445, 19, GRIS);
    DrawText(TextFormat("Comercios registrados: %d | Usuarios: %d | Productos: %d",
        nComercios, nUsuarios, nProductos), 90, 500, 18, GRIS);
    if (Boton(400, 615, 300, 50, "VOLVER"))
        VolverAdministrador();
}

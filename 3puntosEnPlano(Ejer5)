#include <iostream>
#include <cmath>
#include <iomanip>
using namespace std;
int main() {
    double x1, y1, x2, y2, x3, y3;

    cout << "Ingrese las coordenadas del punto 1 (x1 y1): ";
    cin >> x1 >> y1;
    cout << "Ingrese las coordenadas del punto 2 (x2 y2): ";
    cin >> x2 >> y2;
    cout << "Ingrese las coordenadas del punto 3 (x3 y3): ";
    cin >> x3 >> y3;
    double D = 2 * (x1 * (y2 - y3) + x2 * (y3 - y1) + x3 * (y1 - y2));

    if (abs(D) < 1e-9) {
        cout << "\nError: Los tres puntos son colineales (estan en una misma linea recta). No forman una circunferencia.\n";
        return 0;
    }
    double h = ((x1 * x1 + y1 * y1) * (y2 - y3) + 
                (x2 * x2 + y2 * y2) * (y3 - y1) + 
                (x3 * x3 + y3 * y3) * (y1 - y2)) / D;
    double k = ((x1 * x1 + y1 * y1) * (x3 - x2) + 
                (x2 * x2 + y2 * y2) * (x1 - x3) + 
                (x3 * x3 + y3 * y3) * (x2 - x1)) / D;
    double r = sqrt(pow(x1 - h, 2) + pow(y1 - k, 2));
    cout << fixed << setprecision(2);
    cout << "\n--- Resultados ---\n";
    cout << "Centro de la circunferencia: (" << h << ", " << k << ")\n";
    cout << "Radio: " << r << "\n";

    return 0;
}

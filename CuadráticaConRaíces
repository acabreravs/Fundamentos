#include <iostream>
#include <cmath>
using namespace std;
int main()
{
    float a,b,c,D;
    double x1,x2;
    cout<<"Ingresa el valor de a: "<<endl;
    cin>>a;
    if(a==0)
        cout<<"ERROR: No se puede calcular";
        else
        {
            cout<<"Ingresa el valor de b: "<<endl;
            cin>>b;
            cout<<"Ingresa el valor de c: "<<endl;
            cin>>c;
            D=b*b-4*a*c;
            if(D==0)
                cout<<"La solución es única: "<<-b/(2*a);
            else
            {
                if(D>0)
                {
                    x1=(-b+sqrt(b*b-4*a*c))/(2*a);
                    x2=(-b-sqrt(b*b-4*a*c))/(2*a);
                    cout<<"La solución x1 es: "<<x1<<endl;
                    cout<<"La solución x1 es: "<<x2;
                }else
                {
                    x1=-b/(2*a);
                    x2=sqrt(-D)/(2*a);
                    cout<<"El valor de la primer raíz x1 es: "<<x1<<"+"<<x2<<"i"<<endl;
                    cout<<"El valor de la primer raíz x2 es: "<<x1<<"-"<<x2<<"i";
                }
            }
        }
    
    return 0;
}

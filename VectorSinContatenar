//SIN EL 9 DEL PRÁCTICO
#include <iostream>
#define MAX 100//Constante de compilador
using namespace std;
//prototipos
void cargar(int a[], int tam);
void mostrar(int a[], int tam);
void burbuja(int a[], int tam);
int main()
{
    int opcion,n,v[MAX];
    do {
        cout << " MENU " << endl;
        cout << "1. Cargar " << endl;
        cout << "2. Mostrar " << endl;
        cout << "3. Clasificar " << endl;
        cout << "0. Salir " << endl;
        cout << "Selecciona una opcion: " << endl;
        cin >> opcion;
        switch (opcion) 
        {
            case 1:
                do {
                    cout << "Cuantos elementos quiere?: " << endl;
                    cin >> n;
                } while (n > MAX || n < 0);
                cargar(v,n);
                break;
            case 2:
                mostrar(v, n);
                break;
            case 3:
                burbuja(v, n);
                break;
            case 0:
                cout << "Saliendo del programa...";
                break;
            default:
                cout << "ERROR ";
        }
    } while (opcion != 0);
    
}
//Declaración de funciones
void cargar(int a[], int tam) {
    for (int i = 0; i < tam; i++) {
        cout << "V[" << i << "]= ";
        cin >> a[i];
    }
}//Pide los datos en el vector
void mostrar(int a[], int tam) {
    for (int i = 0; i < tam; i++) {
        cout << "V[" << i << "]= ";
        cout<< a[i]<<endl;
    }
}
void burbuja(int a[], int tam) {
    int aux;
    for (int i = 0; i < tam - 1; i++) {
        for (int j = i + 1; j < tam; j++) {
            if (a[i] > a[j]) {
                aux = a[j];
                a[j] = a[i];
                a[i] = aux;
            }
        }
    }
}

#include <iostream>
#include <cmath>
using namespace std;
int main()
{
    int n,cont=2, primos=0;
    cout<<"Ingrese el número de números primos a generar: ";
    cin>>n;
    while(primos<n)
    {
        bool flag=true;
        for(int i=2;i<=sqrt(cont);i++)
            if(cont%i==0){
                flag=false;
                break;
            }
        if(flag){
            cout<<cont<<",";
            primos++;
        }
        cont++;
    }
    return 0;
}

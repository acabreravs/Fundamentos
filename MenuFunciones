int menor(int a, int b) {
	if (a > b)
		return b;
	else
		return a;
}
int signo(float r) {
	if (r == 0)
		return 0;
	else
		if (r < 0)
			return -1;
		else
			return 1;
}
int potencia(int base, int exp) {
	int acum = 1;
	for (int i = 1; i <= exp; i++)
		acum = acum * base;
	return acum;
}

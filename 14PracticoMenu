#include <iostream>
using namespace std;
int main()
{
    int cantidad,opcion;
    float precio,total;
    cout<<"Menú: "<<endl;
    cout<<"ITEM"<<endl;
    cout<<"1.- Hamburguesas(3bs)"<<endl;
    cout<<"2.- Hamburguesas con queso(5Bs)"<<endl;
    cout<<"3.- Papas fritas(2Bs)"<<endl;
    cout<<"4.- Soda(2.5Bs)"<<endl;
    cout<<"0.- Salir"<<endl;
    cout<<"Ingresa la opción: "<<endl;
    cin>>opcion;
    cout<<"Ingresa la cantidad: "<<endl;
    cin>>cantidad;
    switch(opcion)
    {
        case 1:
            precio=3;
            total=cantidad*precio;
            break;
        case 2:
            total=cantidad*5;
            break;
        case 3:
            total=cantidad*2;
            break;
        case 4:
            total=cantidad*2.5;
            break;
        case 0:
            cout<<"Salir"<<endl;
            break;
        default:
            cout<<"Error"<<endl;
    }
    cout<<"El total es: "<<total<<endl;
    return 0;
}
